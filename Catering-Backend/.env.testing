APP_NAME="Catering Inventory System"
APP_ENV=testing
APP_KEY=base64:2fl+Ktvkdl+I45K52+raljyVFQewTuqRBCjJ/BRLOCw=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Test database configuration - uses in-memory SQLite
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

# Reduce encryption rounds for faster testing
BCRYPT_ROUNDS=4

# Disable telescope in tests
TELESCOPE_ENABLED=false